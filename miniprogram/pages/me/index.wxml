<view class="page">
  <view wx:if="{{testing}}" class="testing">测试环境 · 模拟身份不代表真实微信验证</view>
  <view class="title">我的</view>
  <view class="status">{{status}}</view>
  <view class="note">{{detail}}</view>
  <view wx:if="{{!configured}}" class="note">个人服务尚未配置。</view>
  <button wx:if="{{!authenticated}}" bindtap="login" disabled="{{busy || !configured}}" loading="{{busy}}">主动登录</button>
  <button bindtap="refreshNow" disabled="{{busy}}">刷新登录状态</button>
  <button wx:if="{{authenticated}}" bindtap="logout" disabled="{{busy}}" loading="{{busy}}">退出登录</button>
  <button bindtap="showPrivacy">查看用途与隐私说明</button>
  <view wx:if="{{showPrivacy}}" class="note privacy">{{privacy}}</view>
</view>
