.observation { margin: 36rpx 0; padding: 32rpx; border-radius: 24rpx; background: #eeeeea; }
.observation.live { background: #e0ede7; }
.state { font-size: 62rpx; line-height: 1.3; font-weight: 600; margin-bottom: 24rpx; }
